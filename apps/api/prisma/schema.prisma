generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum VideoStatus {
  UPLOADED
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum Verdict {
  LIKELY_REAL
  UNCERTAIN
  LIKELY_FAKE
}

enum ContactStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
}

enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ModelBackend {
  HF
  MOCK
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String?
  passwordHash    String
  role            Role        @default(USER)
  plan            Plan        @default(FREE)
  emailVerifiedAt DateTime?
  bannedAt        DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sessions           Session[]
  apiKeys            ApiKey[]
  videos             Video[]
  usage              UsageRecord[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]          @relation("AuditActor")

  @@index([role])
  @@index([createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String           @id @default(cuid())
  userId    String
  type      VerificationType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Video {
  id              String      @id @default(cuid())
  userId          String
  storageKey      String      @unique
  originalName    String
  mimeType        String
  sizeBytes       BigInt
  durationSeconds Float?
  width           Int?
  height          Int?
  status          VideoStatus @default(UPLOADED)
  error           String?
  jobId           String?
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis?

  @@index([userId, createdAt])
  @@index([status])
  @@index([expiresAt])
}

model Analysis {
  id               String   @id @default(cuid())
  videoId          String   @unique
  modelVersion     String
  modelName        String
  backend          String
  fakeScore        Int
  fakeProbability  Float
  verdict          Verdict
  confidence       Float
  temporalScore    Float?
  audioScore       Float?
  framesAnalyzed   Int
  facesDetected    Int
  frameScores      Json
  flaggedFrames    Json
  details          Json
  createdAt        DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([verdict])
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  month     String
  analyses  Int      @default(0)
  bytes     BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([month])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model ModelVersion {
  id                     String       @id @default(cuid())
  name                   String
  version                String
  backend                ModelBackend
  modelId                String
  calibrationTemperature Float        @default(1)
  metrics                Json?
  notes                  String?
  isActive               Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([backend, modelId, version])
  @@index([isActive])
}
