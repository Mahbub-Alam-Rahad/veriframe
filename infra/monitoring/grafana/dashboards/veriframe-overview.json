      "targets": [{ "expr": "rate(pg_stat_database_tup_fetched{datname=~\"$database\"}[5m])", "legendFormat": "{{datname}}", "refId": "A" }],
      "title": "PostgreSQL tuple fetch rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
