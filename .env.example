# ---------------------------------------------------------------------------
# VeriFrame / Deepfake Detection Platform - environment template
# Copy to .env and replace every "change-me" value before running.
# Run `./scripts/setup.sh` to generate strong secrets automatically.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=VeriFrame
PUBLIC_WEB_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=/api/v1

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=deepfake
DATABASE_URL=postgresql://deepfake:change-me-postgres@localhost:5432/deepfake?schema=public

# --- Redis / BullMQ --------------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=deepfake
WORKER_CONCURRENCY=2

# --- Authentication --------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
# Set to true whenever the public site is served over HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=1

# Bootstrap super admin (created by the seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-123456!
ADMIN_NAME=Platform Admin

# --- Object storage (MinIO / any S3 compatible) ----------------------------
# S3_ACCESS_KEY / S3_SECRET_KEY are also used as the MinIO root credentials
# in the bundled Compose stack.
S3_ENDPOINT=http://localhost:9000
# This URL is signed and handed to the browser. It must be reachable by users.
# Local default: http://localhost:9000. Production: a dedicated HTTPS endpoint
# such as https://storage.example.com.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=deepfake
S3_FORCE_PATH_STYLE=true

# --- ML service ------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=change-me-internal-token-at-least-32-characters
ML_TIMEOUT_MS=900000
# "mock" is a deterministic development backend and is NOT a real detector.
# Set MODEL_BACKEND=hf for model-based inference.
MODEL_BACKEND=mock
MODEL_ID=dima806/deepfake_vs_real_image_detection
MODEL_DEVICE=cpu
MODEL_CALIBRATION_TEMPERATURE=1.0
FAKE_LABEL_INDEX=1
SAMPLE_FPS=1.0
MAX_FRAMES=120
MAX_VIDEO_SECONDS=600
MAX_CONCURRENT_ANALYSES=1
# Falling back to mock scores in production is dangerous. Keep false there.
ALLOW_MOCK_FALLBACK=true
HF_HOME=/models/hf-cache
HF_HUB_OFFLINE=false
HF_TRUST_REMOTE_CODE=false

# --- Email -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VeriFrame <no-reply@example.com>"
# Development only: returns verification/reset links in API responses.
# Compose defaults this to false via COMPOSE_EXPOSE_DEV_TOKENS.
EXPOSE_DEV_TOKENS=true

# --- Product / operations --------------------------------------------------
RETENTION_DAYS=30
MAX_UPLOAD_BYTES=2147483648
FREE_MONTHLY_ANALYSES=3
PRO_MONTHLY_ANALYSES=100
ENTERPRISE_MONTHLY_ANALYSES=2000
SWAGGER_ENABLED=true
LOG_LEVEL=info

# --- Docker Compose only ---------------------------------------------------
# Public site address for Caddy. Use http://localhost:3000 for a local stack,
# or a DNS name such as detect.example.com for automatic Let's Encrypt HTTPS.
SITE_ADDRESS=http://localhost:3000
ACME_EMAIL=
# Optional host port overrides when 80/443 are already in use.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Keep MinIO bound to loopback by default. Change to 0.0.0.0 only when the
# browser-facing S3_PUBLIC_ENDPOINT needs to be reached from other machines.
MINIO_BIND=127.0.0.1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Development links in API responses when running through Compose. Leave
# false in production and configure SMTP instead.
COMPOSE_EXPOSE_DEV_TOKENS=false
# Expose /api/docs through the reverse proxy. Disabled by default in Compose.
COMPOSE_SWAGGER_ENABLED=false
BACKUP_RETENTION_DAYS=14
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
MLFLOW_PORT=5000
